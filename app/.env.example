# Public HTTPS proxy URL. Enter it in the app Settings screen on the phone.
SERVER_URL=https://your-render-url.onrender.com

# Entered in the app's Settings screen and stored with SecureStore, not bundled.
SHARED_APP_TOKEN=

# Server-only credentials. Do not copy real values into the app environment.
POLYGON_API_KEY=
ANTHROPIC_API_KEY=
